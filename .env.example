# Local S3-compatible storage (MinIO). Replace endpoint and credentials for AWS S3.
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=assetflow-data
AWS_ACCESS_KEY_ID=assetflow
AWS_SECRET_ACCESS_KEY=assetflow123
AWS_DEFAULT_REGION=us-east-1

# Analytics PostgreSQL database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=assetflow_analytics
POSTGRES_USER=assetflow
POSTGRES_PASSWORD=assetflow

